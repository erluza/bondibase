// ============================================================
// FIRESTORE SECURITY RULES — Bondibase
// ============================================================
// IMPORTANTE: Copiá estas reglas en la consola de Firebase:
// Firebase Console → Firestore Database → Reglas
//
// Estas reglas protegen la base de datos para que:
// - Cualquier persona pueda LEER datos (la app es pública)
// - Solo usuarios autenticados puedan CREAR contenido
// - Solo el dueño de un documento pueda MODIFICARLO o BORRARLO
// - Los campos críticos no puedan ser manipulados
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USUARIOS ──
    // Lectura pública (perfiles visibles para todos)
    // Escritura solo por el dueño del documento (uid == userId)
    match /users/{userId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    // No permitir cambiar el uid propio
                    && request.resource.data.uid == resource.data.uid;

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // ── RESEÑAS ──
    // Lectura pública (feed comunitario)
    // Crear solo si está autenticado y el userUid coincide
    // Editar/borrar solo el autor original
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.userUid == request.auth.uid;

      allow update: if request.auth != null
                    && (
                      // El autor original puede editar su reseña
                      (
                        resource.data.userUid == request.auth.uid
                        && request.resource.data.userUid == resource.data.userUid
                        && request.resource.data.id == resource.data.id
                      )
                      // O cualquier usuario autenticado puede dar / quitar Me Gusta (solo campos likes y likedBy)
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
                    );

      allow delete: if request.auth != null
                    && resource.data.userUid == request.auth.uid;
    }

    // ── BLOQUEAR TODO LO DEMÁS ──
    // Cualquier colección no definida arriba queda bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
